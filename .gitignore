.DS_Store

# Sicherungskopien bleiben örtlich – sie gehören nicht in ein öffentliches Repository.
Sicherungskopien/

# Die Änderungslogs ebenso: interne Arbeitsnotizen, nicht für die Veröffentlichung.
Änderungslog_*.md

# Der Doppelklick-Helfer zum Abgleichen bleibt örtlich – ein öffentlich
# abrufbares Shell-Skript hat auf der Seite nichts zu suchen.
Preisliste abgleichen.command

# Angebotsdateien, falls eine versehentlich hier landet: enthalten Kundenangaben.
OS_Angebot_*.json
AV_Angebot_*.json

# Achtung: Angebotsdaten.xlsx ist hier ausdrücklich NICHT ausgeschlossen –
# sie ist die Preisliste, aus der die Werkzeuge lesen. Ohne sie starten sie leer.
